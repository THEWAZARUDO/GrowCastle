+                try { Win32.LeftUp(); } catch { }
+
+                SafeUi(() =>
+                {
+                    _btnStartStop.Text = "▶ BẮT ĐẦU (F6)";
+                    _btnStartStop.BackColor = Color.FromArgb(22, 163, 74);
+                    _lblStatus.Text = "Trạng thái: Đã dừng";
+                });
+            }
+        });
+    }
